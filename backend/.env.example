# Copy to backend/.env and fill in. Never commit the real .env.

# --- Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- PostgreSQL ---
# Required: src/config/db.js reads DATABASE_URL directly.
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=public

# --- JWT ---
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=300m
JWT_REFRESH_TTL=7d

# --- Google Drive (service account) ---
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_CLIENT_EMAIL=
# Keep literal \n and wrap in quotes; the code restores the newlines.
GOOGLE_DRIVE_PRIVATE_KEY=

# --- Mailjet (email) ---
MJ_APIKEY_PUBLIC=
MJ_APIKEY_PRIVATE=
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=Municipal Office of Population

# --- TextBee (SMS) ---
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

# --- Scheduled jobs ---
# Overdue file-task SMS reminder. Standard 5-field cron, server timezone.
# Default: 07:05 every day (each recipient is reminded at most once per day).
FILE_TASK_OVERDUE_REMINDER_CRON=5 7 * * *